# Coordination Games server and local web URLs
GAME_SERVER=http://127.0.0.1:8787
WEB_BASE_URL=http://localhost:5173
INSPECTOR_TOKEN=local-inspector-token

# Game/run controls
GAME_TYPE=tragedy-of-the-commons
BOT_COUNT=4
TEAM_SIZE=2
HARNESS_ROUNDS=12
HARNESS_COMMUNICATION_SWEEPS=1
HARNESS_MODEL_TIMEOUT_MS=90000
HARNESS_MODEL_RETRIES=1
HARNESS_GAME_API_TIMEOUT_MS=10000
HARNESS_GAME_API_RETRIES=2
HARNESS_GAME_API_RETRY_BASE_DELAY_MS=250
HARNESS_ARTIFACTS=1
HARNESS_RESULTS_DIR=runs/model-harness
HARNESS_MAX_COST_USD=0
HARNESS_PROMPT_USD_PER_1M=0
HARNESS_COMPLETION_USD_PER_1M=0
BOT_CONFIG=examples/tragedy-bots.example.json
APPEND_ADDRESS_SUFFIX=true

# Provider: scripted | openai-compatible | minimax | opencode-go
PROVIDER=scripted
OPENAI_BASE_URL=https://api.minimax.io/v1
OPENCODE_GO_BASE_URL=http://127.0.0.1:4096
OPENCODE_GO_AGENT=plan
# Optional only when your local opencode serve process is protected with Basic auth.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
MODEL=MiniMax-M2.7-highspeed
MODEL_TEMPERATURE=1
MODEL_TOP_P=0.95
MODEL_MAX_COMPLETION_TOKENS=1024
MODEL_REASONING_SPLIT=true
MODEL_REASONING_EFFORT=

# Export one of these in your shell for openai-compatible/minimax runs.
# Do not commit real keys.
OPENAI_API_KEY=
MINIMAX_API_KEY=
